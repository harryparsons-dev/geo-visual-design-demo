---
import Layout from '../../layouts/Layout.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import {getContent} from '../../lib/content';
export async function getStaticPaths() {
  const content = await getContent();
  return content.projects.map((project, index) => ({
    params: {slug: project.slug},
    props: {...content, project, next: content.projects.length > 1 ? content.projects[(index + 1) % content.projects.length] : undefined},
  }));
}
const {settings, demo, project, next} = Astro.props;
---
<Layout title={`${project.title} — ${settings.name}`} description={project.description} settings={settings} demo={demo} image={project.thumbnail.url}>
  <article class="project-detail wrap">
    <a class="text-link" href="/#work">← All work</a>
    <header class="detail-header">
      <p class="eyebrow">{project.category} / {project.year}</p>
      <h1>{project.title}</h1>
    </header>
    <VideoPlayer url={project.videoUrl} title={project.title} poster={project.thumbnail.url} alt={project.thumbnail.alt} />
    <div class="project-story">
      <h2>About the film</h2>
      <div>
        <p class="preserve-lines">{project.description}</p>
        {project.credits && <p class="credits preserve-lines">{project.credits}</p>}
      </div>
    </div>
    {next && <a class="next-project" href={`/work/${next.slug}/`}><span class="eyebrow">Next film</span><span>{next.title} ↗</span></a>}
  </article>
</Layout>
