---
import '../styles/global.css';
import type {Settings} from '../lib/content';
interface Props {title: string; description: string; settings: Settings; demo?: boolean; image?: string}
const {title, description, settings, demo, image} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#181b17" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    {demo && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    {image && <meta property="og:image" content={Astro.site ? new URL(image, Astro.site) : image} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {demo && <aside class="demo-banner">Demo portfolio · Illustrative projects and sample playback</aside>}
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-label={`${settings.name} — home`}>{settings.name}<span aria-hidden="true">↗</span></a>
      <nav aria-label="Main navigation">
        <a href="/#work">Work</a>
        <a href="/#about">About</a>
        <a href="/#contact">Let’s talk <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <a class="wordmark" href="/">{settings.name}<span aria-hidden="true">↗</span></a>
      <p>© {new Date().getFullYear()} {settings.name}</p>
      <a href="#main">Back to top ↑</a>
    </footer>
  </body>
</html>
