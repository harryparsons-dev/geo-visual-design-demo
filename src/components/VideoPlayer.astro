---
import {getYouTubeId} from '../lib/video';
import {imageUrl} from '../lib/content';
interface Props {url: string; title: string; poster: string; alt: string}
const {url, title, poster, alt} = Astro.props;
const id = getYouTubeId(url);
if (!id) throw new Error(`Unsupported video URL: ${url}`);
---
<portfolio-video data-video-id={id} data-title={title}>
  <div class="video-frame">
    <img src={imageUrl(poster, 1600)} alt={alt} width="1600" height="900" fetchpriority="high" />
    <button class="play-button" type="button" aria-label={`Play ${title}`} hidden>
      <span class="play-icon" aria-hidden="true">▶</span><span>Play film</span>
    </button>
  </div>
  <p class="video-note">Playback loads YouTube when you press play. <a href={url} target="_blank" rel="noopener noreferrer">Watch on YouTube ↗</a></p>
</portfolio-video>
<script>
  class PortfolioVideo extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button');
      if (!button || button.dataset.ready) return;
      button.dataset.ready = 'true';
      button.hidden = false;
      button.addEventListener('click', () => {
        const frame = document.createElement('iframe');
        frame.src = `https://www.youtube-nocookie.com/embed/${this.dataset.videoId}?autoplay=1&rel=0`;
        frame.title = this.dataset.title || 'Film';
        frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        frame.allowFullscreen = true;
        frame.referrerPolicy = 'strict-origin-when-cross-origin';
        this.querySelector('.video-frame')?.replaceChildren(frame);
        frame.focus();
      }, {once: true});
    }
  }
  if (!customElements.get('portfolio-video')) customElements.define('portfolio-video', PortfolioVideo);
</script>
